+uint32_t sun3x_state::timeout_r(offs_t offset)
+{
+	if (!machine().side_effects_disabled())
+	{
+		logerror("bus timeout: read %08x (PC %08x)\n", 0x04000000 + offset * 4, m_maincpu->pc());
+		m_buserr |= 0x20000000;
+		bus_error();
 	}
+	return 0xffffffff;
+}
