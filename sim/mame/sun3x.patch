+// RD68031: MAME's m68000 family takes a bus error from a pulse on an input
+// line; the RD68031 core ends the bus cycle in flight with BERR.
+void sun3x_state::bus_error()
+{
+	if (m_rdcpu)
+	{
+		m_rdcpu->bus_error();
+		return;
+	}
+	m_maincpu->set_input_line(M68K_LINE_BUSERROR, ASSERT_LINE);
+	m_maincpu->set_input_line(M68K_LINE_BUSERROR, CLEAR_LINE);
+}
