+		m_dma_csr |= DMA_INT_PEND;
+	const bool irq = (m_dma_csr & (DMA_INT_PEND | DMA_ERR_PEND)) && (m_dma_csr & DMA_INT_EN);
+	if (irq != m_dma_irq)
+	{
+		m_dma_irq = irq;
+		update_irqs();
+	}
+}
