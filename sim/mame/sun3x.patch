+
+uint32_t sun3x_state::dma_csr_r()
+{
+	if (m_dma_csr & DMA_TC)
+	{
+		m_dma_tc_read = true;
+		dma_check_interrupts();
+	}
+	return (m_dma_csr & ~(DMA_FLUSH | 0x1800)) | DMA_DEV_ID;
