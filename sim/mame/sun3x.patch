+
+void sun3x_state::dma_csr_w(offs_t offset, uint32_t data, uint32_t mem_mask)
+{
+	mem_mask &= DMA_RW_BITS;
+	COMBINE_DATA(&m_dma_csr);
+	if (data & DMA_RESET)
+		m_dma_csr &= ~(DMA_ERR_PEND | DMA_PACK_CNT | DMA_INT_EN | DMA_DRAIN | DMA_WRITE | DMA_EN_DMA | DMA_REQ_PEND | DMA_EN_CNT | DMA_TC);
