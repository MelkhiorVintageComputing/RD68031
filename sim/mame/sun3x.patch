+// ---------------------------------------------------------------------------
+// RD68031: DVMA through the I/O Mapper.
+
+bool sun3x_state::dvma_xlate(uint32_t dvma, uint32_t &pa)
+{
+	const uint32_t pte = m_iommu[(dvma >> 13) & 0x7ff];
+	if ((pte & 3) != 1)
+	{
+		logerror("DVMA %06x: invalid I/O Mapper entry %08x\n", dvma & 0xffffff, pte);
+		return false;
+	}
+	pa = (pte & 0x03ffe000) | (dvma & 0x1fff);
+	return true;
+}
+
+uint32_t sun3x_state::dvma_r32(uint32_t dvma)
+{
+	uint32_t pa;
+	if (!dvma_xlate(dvma, pa))
+		return 0xffffffff;
+	return m_maincpu->space(AS_PROGRAM).read_dword(pa & ~3);
+}
+
+void sun3x_state::dvma_w32(uint32_t dvma, uint32_t data, uint32_t mem_mask)
+{
+	uint32_t pa;
+	if (!dvma_xlate(dvma, pa))
+		return;
+	m_maincpu->space(AS_PROGRAM).write_dword(pa & ~3, data, mem_mask);
+}
