+namespace {
+constexpr uint32_t DMA_DEV_ID    = 0x00000000; // rev 0
+constexpr uint32_t DMA_TC        = 0x00004000;
+constexpr uint32_t DMA_EN_CNT    = 0x00002000;
+constexpr uint32_t DMA_REQ_PEND  = 0x00000400;
+constexpr uint32_t DMA_EN_DMA    = 0x00000200;
+constexpr uint32_t DMA_WRITE     = 0x00000100;
+constexpr uint32_t DMA_RESET     = 0x00000080;
+constexpr uint32_t DMA_DRAIN     = 0x00000040;
+constexpr uint32_t DMA_FLUSH     = 0x00000020;
+constexpr uint32_t DMA_INT_EN    = 0x00000010;
+constexpr uint32_t DMA_PACK_CNT  = 0x0000000c;
+constexpr uint32_t DMA_ERR_PEND  = 0x00000002;
+constexpr uint32_t DMA_INT_PEND  = 0x00000001;
+constexpr uint32_t DMA_RW_BITS   = DMA_EN_CNT | DMA_EN_DMA | DMA_WRITE | DMA_RESET | DMA_DRAIN | DMA_INT_EN;
+}
+
+void sun3x_state::dma_check_interrupts()
+{
+	const bool tc = (m_dma_csr & DMA_TC) && !m_dma_tc_read;
+	m_dma_csr &= ~DMA_INT_PEND;
