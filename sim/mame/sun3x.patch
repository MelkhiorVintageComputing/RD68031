+void sun3x_state::sun3_80ref(machine_config &config)
+{
+	sun3_80(config);
+	// The core has no FPU: a coprocessor instruction takes the F-line
+	// exception on both.
+	downcast<m68030_device &>(*m_maincpu.lookup()).set_fpu_enable(false);
+}
+
+void sun3x_state::sun3_80rd(machine_config &config)
+{
+	sun3_80(config);
+	RD68031(config.replace(), m_maincpu, 20000000);
+	m_maincpu->set_addrmap(AS_PROGRAM, &sun3x_state::sun3_80_mem);
+	rd68031_device &rd = downcast<rd68031_device &>(*m_maincpu.lookup());
+	// Main memory, the PROM's two windows and the frame buffer are memory;
+	// the rest are device registers, which a board answers with CIIN.
+	rd.add_cacheable(0x00000000, 0x03ffffff);
+	rd.add_cacheable(0x63000000, 0x6301ffff);
+	rd.add_cacheable(0xfefe0000, 0xfefeffff);
+}
