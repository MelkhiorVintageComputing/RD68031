mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
echo "=============================================="
echo " RD68031 rd-virt initramfs: hello from /init"
echo "=============================================="
uname -a
cat /proc/cpuinfo
cat /proc/interrupts
free
ls /sys/bus/platform/devices | head -20
cat /sys/class/rtc/rtc0/time 2>/dev/null
echo "sum test: $((6*7))"
echo "awk float: $(awk 'BEGIN{printf "%.6f", atan2(1,1)*4}')"
echo "powering off"
poweroff -f
