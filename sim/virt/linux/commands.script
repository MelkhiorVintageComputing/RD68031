# Source location: https://github.com/MelkhiorVintageComputing/RD68031
#
# rd-virt's scripted command set (make virt-linux, virt-uae, virt-linux-solo):
# `expect <text>` waits for the text on the console, `send <text>` types it
# (\n is a newline). The kernel is booted with rdvirt.shell, so /init ends in
# a shell on the console. Typing goes through the goldfish-tty's receive
# interrupt and its DMA into RAM, which the boot alone never exercises.
expect rd-virt: shell
expect # 
send echo sum $((6*7)) product $((123*457))\n
expect sum 42 product 56211
send uname -m -r\n
expect 7.2.9-rdvirt m68k
send grep -c virtio /proc/interrupts; grep CPU: /proc/cpuinfo\n
expect 68030
send seq 1 200 | md5sum\n
expect 304f7b9574921ad21a2bc72f200483d7
send echo hello > /tmp.txt; cat /tmp.txt; wc -c < /tmp.txt\n
expect 6
send ls /sys/class/rtc\n
expect rtc0
send echo $(for i in 1 2 3; do echo loop$i; done | sort -r)\n
expect loop3 loop2 loop1
send echo done\n
expect done
send poweroff -f\n
